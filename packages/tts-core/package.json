{
  "name": "@dittli/tts-core",
  "version": "0.5.0",
  "description": "DittliTTS inference engine for the browser — ONNX Runtime Web. Install a language pack (@dittli/tts-en, @dittli/tts-de) alongside this to synthesise speech.",
  "type": "module",
  "main": "src/index.js",
  "module": "src/index.js",
  "types": "src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    },
    "./internal": {
      "types": "./src/internal.d.ts",
      "import": "./src/internal.js",
      "default": "./src/internal.js"
    },
    "./ort-wasm/*": "./ort-wasm/*"
  },
  "files": [
    "src/**/*.js",
    "src/**/*.d.ts",
    "ort-wasm/**"
  ],
  "sideEffects": false,
  "scripts": {
    "prepublishOnly": "node scripts/copy-ort-wasm.js && node ../../scripts/check-publish-assets.js tts-core"
  },
  "keywords": [
    "tts",
    "text-to-speech",
    "speech-synthesis",
    "onnx",
    "onnxruntime-web",
    "browser",
    "webassembly",
    "lightweight",
    "offline-tts"
  ],
  "author": "Dittli TTS Contributors",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dittlihq/dittli-tts.git",
    "directory": "packages/tts-core"
  },
  "bugs": {
    "url": "https://github.com/dittlihq/dittli-tts/issues"
  },
  "homepage": "https://github.com/dittlihq/dittli-tts#readme",
  "dependencies": {
    "onnxruntime-web": "^1.26.0"
  }
}
