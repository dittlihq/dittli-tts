{
  "name": "dittli-tts",
  "version": "0.1.0",
  "description": "Ultra-lightweight text-to-speech (1.6M params). Pure Node.js inference via ONNX Runtime — zero Python dependency.",
  "main": "src/node/index.js",
  "types": "src/node/index.d.ts",
  "files": [
    "src/node/index.js",
    "src/node/index.d.ts",
    "src/node/g2p_en.js",
    "src/node/g2p_de.js",
    "src/node/g2p_de_rules.json",
    "src/node/cmudict.json",
    "src/node/g2p_predict.js",
    "src/node/g2p_model.json",
    "src/node/bin/cli.js",
    "src/node/README.md",
    "models/*.json"
  ],
  "bin": {
    "dittli-tts": "src/node/bin/cli.js"
  },
  "keywords": [
    "tts",
    "text-to-speech",
    "speech-synthesis",
    "onnx",
    "lightweight",
    "node-tts",
    "edge-tts",
    "offline-tts"
  ],
  "author": "Dittli TTS Contributors",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dittlihq/dittli-tts.git",
    "directory": "src/node"
  },
  "bugs": {
    "url": "https://github.com/dittlihq/dittli-tts/issues"
  },
  "homepage": "https://github.com/dittlihq/dittli-tts#readme",
  "dependencies": {
    "commander": "^12.0.0",
    "onnxruntime-node": "^1.19.0",
    "wavefile": "^11.0.0"
  },
  "scripts": {
    "test": "pytest",
    "test:unit": "pytest tests/unit",
    "test:parity": "pytest tests/parity",
    "test:integration": "pytest tests/integration",
    "test:slow": "pytest -m slow",
    "test:all": "pytest -m ''",
    "lint": "biome check . && ruff check . && ruff format --check .",
    "lint:fix": "biome check --write . && ruff check --fix . && ruff format .",
    "lint:js": "biome check .",
    "lint:py": "ruff check . && ruff format --check .",
    "lint:migrate": "npx @biomejs/biome migrate --write",
    "g2p:gen": "python scripts/gen_de_rules.py",
    "g2p:metadata": "python scripts/gen_metadata.py",
    "export:onnx": "python -m dittli_tts.inference.export"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.13"
  }
}
